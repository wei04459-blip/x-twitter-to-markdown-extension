{
  "manifest_version": 3,
  "name": "X/Twitter to Markdown",
  "description": "Export visible X/Twitter posts and images from the current page to Markdown.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export X/Twitter to Markdown"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "notifications",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://pbs.twimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
